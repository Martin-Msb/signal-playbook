{
  "name": "signal-path",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gen": "node scripts/gen-guides.mjs",
    "dev": "npm run gen && npm run dev -w @signal-path/site",
    "build": "npm run gen && npm run build -w @signal-path/site",
    "test": "npm run gen && npm test -w @signal-path/engine",
    "preview:single": "node scripts/single-file.mjs",
    "preview:app": "node scripts/single-app.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
